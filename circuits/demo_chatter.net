# DEMO: numerical chatter (Watson & Arrillaga section 9.4; chapter 8 of the Tiny book)
#
# A 10 V battery drives 1 ohm + 1 mH; the switch opens at 3 ms. The current stops, but with the
# plain trapezoidal rule the inductor voltage (node 3) flips between +187 V and -187 V at every
# time step for the rest of the run: numerical chatter, not physics.
#
# Chatter removal and interpolation are OFF in this file. To see the fix in the editor:
#   1. Run, and look at V3 (zoom into 2.5-4 ms).
#   2. Tick "Hold run" above the plots.
#   3. Under Run settings, tick "Chatter removal", and Run again.
# The held run (grey dashed) keeps chattering; the new run is flat at 0 V after 3 ms.
# Command line: run.bat circuits\demo_chatter.net --chatter=on
#
# Generated by circuits/make_drawings.py; open it in the circuit editor (gui.bat) to see the drawing.
#
# EMTSim netlist: demo: chatter after opening a switch (drawn with the EMTSim circuit editor)
#
# Format: R/L/C from to value | V from to peak angle freq [R] | SW from to closed|open times... | F from to t_apply [t_clear]
# 3 nodes, 4 elements

.tran 0.0001 0.005

.options chatter=off interp=off

V 0 1  10 0 0   # BATTERY
SW 1 2  closed 0.003   # SWITCH
R 2 3  1   # R
L 3 0  0.001   # L

#@layout {"v":1,"components":[{"type":"V","name":"BATTERY","x":0,"y":8,"rot":0,"params":{"mag":"10","angle":"0","freq":"0","r":"","l":""}},{"type":"GND","name":"GND","x":0,"y":8,"rot":0,"params":{}},{"type":"SW","name":"SWITCH","x":6,"y":8,"rot":0,"params":{"state":"closed","times":"0.003","opens":"at the time"}},{"type":"R","name":"R","x":10,"y":8,"rot":0,"params":{"value":"1"}},{"type":"L","name":"L","x":14,"y":8,"rot":90,"params":{"value":"1m"}},{"type":"GND","name":"GND","x":14,"y":12,"rot":0,"params":{}}],"wires":[{"x1":4,"y1":8,"x2":6,"y2":8}],"settings":{"dt":"100u","tstop":"5m","chatter":"off","interp":"off"}}
